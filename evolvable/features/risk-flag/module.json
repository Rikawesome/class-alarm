{
  "module": "risk-flag",
  "role": "feature",
  "evolution_policy": "evolvable",
  "storage_namespace": "risk-flag",
  "storage_schema": {
    "version": 1,
    "record": {
      "type": "object",
      "required": ["isRisky"],
      "additionalProperties": false,
      "properties": {"isRisky": {"type": "boolean"}}
    }
  },
  "owns": [
    "evolvable/features/risk-flag/**"
  ],
  "exposes": {
    "isRisky": "(courseId: string) -> boolean",
    "setRisky": "(courseId: string, risky: boolean) -> void",
    "createRiskFlag": "({ storage: PersonalDataCapability }) -> RiskFlag",
    "getAlarmDisplayData": "(course: Course) -> { title: string, body: string }"
  },
  "implements": {
    "alarm-engine.alarmDisplayFormatter": "getAlarmDisplayData"
  },
  "depends_on": [],
  "consumed_by": [
    "app-runtime"
  ],
  "invariants": [
    "never imports protected database or scheduling implementations",
    "receives personal storage only through the host-injected capability"
  ],
  "evolvable_surface": [
    "risk definition logic",
    "alarm display text and formatting"
  ],
  "fixed_interfaces": [
    "isRisky signature",
    "getAlarmDisplayData signature and return shape"
  ],
  "file_policies": {
    "module.json": "human-review",
    "index.js": "evolvable",
    "tests/**": "evolvable-additive"
  },
  "test_policy": {
    "owner": "risk-flag",
    "existing_tests": "protected-baseline",
    "new_tests": "evolvable-additive"
  },
  "version": "1.2.0",
  "last_updated": "2026-07-31"
}
