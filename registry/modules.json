{
  "schema_version": "1.0.0",
  "modules": {
    "core-data": {
      "path": "locked/core-data",
      "contract": "locked/core-data/module.json",
      "role": "protected-core",
      "evolution_policy": "locked"
    },
    "personal-data": {
      "path": "locked/personal-data",
      "contract": "locked/personal-data/module.json",
      "role": "protected-capability-host",
      "evolution_policy": "locked"
    },
    "alarm-engine": {
      "path": "locked/alarm-engine",
      "contract": "locked/alarm-engine/module.json",
      "role": "protected-core",
      "evolution_policy": "locked"
    },
    "risk-flag": {
      "path": "evolvable/features/risk-flag",
      "contract": "evolvable/features/risk-flag/module.json",
      "role": "feature",
      "evolution_policy": "evolvable",
      "storage_namespace": "risk-flag",
      "storage_schema": {
        "version": 1,
        "record": {
          "type": "object",
          "required": [
            "isRisky"
          ],
          "additionalProperties": false,
          "properties": {
            "isRisky": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ui": {
      "path": "evolvable/ui",
      "contract": "evolvable/ui/module.json",
      "role": "presentation",
      "evolution_policy": "evolvable",
      "storage_namespace": "ui",
      "storage_schema": {
        "version": 1,
        "record": {
          "type": "object",
          "required": [],
          "additionalProperties": true,
          "properties": {}
        }
      }
    },
    "app-runtime": {
      "path": "app",
      "contract": "app/module.json",
      "role": "composition-root",
      "evolution_policy": "locked"
    },
    "web-shell": {
      "path": "web",
      "contract": "web/module.json",
      "role": "browser-entry",
      "evolution_policy": "locked"
    },
    "evolution-server": {
      "path": "server",
      "contract": "server/module.json",
      "role": "evolution-control-plane",
      "evolution_policy": "locked"
    },
    "governance": {
      "path": "governance",
      "contract": "governance/module.json",
      "role": "governance-control-plane",
      "evolution_policy": "locked"
    },
    "weekly-goals": {
      "path": "evolvable/features/weekly-goals",
      "contract": "evolvable/features/weekly-goals/module.json",
      "role": "feature",
      "evolution_policy": "evolvable",
      "extension": {
        "contract_version": "1.0",
        "enabled": true,
        "runtime": {
          "entry": "index.js",
          "factory_export": "createExtension"
        },
        "authorized_capabilities": [
          "personal-storage"
        ]
      },
      "storage_namespace": "weekly-goals",
      "storage_schema": {
        "version": 1,
        "record": {
          "title": "string",
          "completed": "boolean"
        }
      }
    },
    "revision-planner": {
      "path": "evolvable/features/revision-planner",
      "contract": "evolvable/features/revision-planner/module.json",
      "role": "feature",
      "evolution_policy": "evolvable",
      "extension": {
        "contract_version": "1.0",
        "enabled": true,
        "runtime": {
          "entry": "index.js",
          "factory_export": "createExtension"
        },
        "authorized_capabilities": [
          "personal-storage"
        ]
      },
      "storage_namespace": "revision-planner",
      "storage_schema": {
        "version": 1,
        "record": {
          "topic": "string",
          "courseId": "string",
          "date": "string",
          "completed": "boolean"
        }
      }
    }
  },
  "artifacts": {
    "course-database": {
      "path": "data/",
      "owner": "core-data",
      "kind": "runtime-state",
      "write_policy": "owner-only"
    },
    "evolution-log": {
      "path": "logs/",
      "owner": "evolution-server",
      "kind": "append-only-audit",
      "write_policy": "owner-only"
    },
    "pending-proposals": {
      "path": "server/pending/",
      "owner": "evolution-server",
      "kind": "generated-artifact",
      "write_policy": "owner-only"
    },
    "module-registry": {
      "path": "registry/",
      "owner": "governance",
      "kind": "governance-index",
      "write_policy": "human-review"
    },
    "documentation": {
      "path": "docs/",
      "owner": "governance",
      "kind": "human-knowledge",
      "write_policy": "human-review"
    },
    "build-configuration": {
      "paths": [
        "package.json",
        "package-lock.json",
        "vite.config.js"
      ],
      "owner": "app-runtime",
      "kind": "build-infrastructure",
      "write_policy": "human-review"
    }
  }
}
